    "def sum_proper(n):\n",
    "    \"\"\"Calculate sum of proper divisors of n (s(n) = sigma(n)-n)\"\"\"\n",
    "    if n <= 1:\n",
    "        return 0\n",
    "    total = 0\n",
    "    for d in range(1, n):\n",
    "        if n % d == 0:\n",
    "            total += d\n",
    "    return total\n",
    "\n",
    "test_numbers = [6,8,220,284,7]\n",
    "for num in test_numbers:\n",
    "    s = sum_proper(num)\n",
    "    print(f\"s({num}) = {s}\")"
